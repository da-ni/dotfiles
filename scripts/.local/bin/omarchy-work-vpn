#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/work-vpn"
CONFIG_FILE="$CONFIG_DIR/config"
PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/work-vpn-openconnect.pid"
SECRET_SERVICE="work-vpn"

VPN_NAME="Work VPN"
VPN_SERVER=""
VPN_USERNAME="${USER:-}"
OPENCONNECT_PROTOCOL=""
OPENCONNECT_AUTHGROUP=""
OPENCONNECT_USER_AGENT="AnyConnect OpenConnect"
PROMPT_FOR_OTP=1
PRIVILEGED_HELPER="/usr/local/libexec/omarchy-work-vpn-privileged"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send "$VPN_NAME" "$1"
  else
    printf '%s\n' "$1" >&2
  fi
}

die() {
  notify "$1"
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

load_config() {
  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
  fi
}

ensure_config() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"

  if [[ ! -f "$CONFIG_FILE" ]]; then
    cat >"$CONFIG_FILE" <<'EOF'
# Local machine-private settings for omarchy-work-vpn.
# Do not add this file to the dotfiles repository.

VPN_NAME="Work VPN"
VPN_SERVER="vpn.example.com"
VPN_USERNAME="your.username"

# Common OpenConnect protocols: anyconnect, gp, pulse, f5, fortinet.
# Leave empty to use OpenConnect's default behavior.
OPENCONNECT_PROTOCOL=""

OPENCONNECT_AUTHGROUP=""
OPENCONNECT_USER_AGENT="AnyConnect OpenConnect"

# Set to 0 only if your VPN does not ask for a one-time code.
PROMPT_FOR_OTP=1
EOF
    chmod 600 "$CONFIG_FILE"
    notify "Created $CONFIG_FILE"
  else
    refresh_config
  fi
}

config_has_key() {
  local key="$1"
  grep -Eq "^[[:space:]]*${key}=" "$CONFIG_FILE"
}

append_config_key() {
  local key="$1"
  local value="$2"
  local comment="${3:-}"

  config_has_key "$key" && return 0
  {
    printf '\n'
    [[ -n "$comment" ]] && printf '# %s\n' "$comment"
    printf '%s=%s\n' "$key" "$value"
  } >>"$CONFIG_FILE"
}

refresh_config() {
  chmod 600 "$CONFIG_FILE"

  if grep -Fq 'OPENCONNECT_EXTRA_ARGS=(--no-dtls)' "$CONFIG_FILE"; then
    sed -i 's/^OPENCONNECT_EXTRA_ARGS=(--no-dtls)$/OPENCONNECT_EXTRA_ARGS=()/' "$CONFIG_FILE"
    sed -i '/^# .*DTLS.*--no-dtls/d' "$CONFIG_FILE"
  fi

  append_config_key "OPENCONNECT_AUTHGROUP" '""' "OpenConnect auth group from your old manual command, if required."
  append_config_key "OPENCONNECT_USER_AGENT" '"AnyConnect OpenConnect"'
  sed -i -E '/^[[:space:]]*(OPENCONNECT_NO_EXTERNAL_AUTH|OPENCONNECT_PASSWORD_ON_STDIN|OPENCONNECT_BACKGROUND|OPENCONNECT_EXTRA_ARGS|VPN_INTERFACE|DISABLE_DNS_OVER_TLS|OPENCONNECT_SCRIPT_BASE|DNS_OVER_TLS_WAIT_SECONDS|OPENCONNECT_SETUID)=/d' "$CONFIG_FILE"
}

is_connected() {
  if [[ -s "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    return 0
  fi

  if [[ -n "$VPN_SERVER" ]] && pgrep -af "openconnect.*${VPN_SERVER}" >/dev/null 2>&1; then
    return 0
  fi

  pgrep -x openconnect >/dev/null 2>&1
}

json_status() {
  load_config
  if is_connected; then
    printf '{"text":"󰒘","class":"connected","tooltip":"%s connected"}\n' "$VPN_NAME"
  else
    printf '{"text":"󰦝","class":"disconnected","tooltip":"%s disconnected"}\n' "$VPN_NAME"
  fi
}

read_secret() {
  command -v secret-tool >/dev/null 2>&1 || return 0
  secret-tool lookup service "$SECRET_SERVICE" account "$VPN_USERNAME" 2>/dev/null || true
}

store_secret() {
  local password="$1"
  command -v secret-tool >/dev/null 2>&1 || return 0
  printf '%s' "$password" | secret-tool store \
    --label="$VPN_NAME password" \
    service "$SECRET_SERVICE" \
    account "$VPN_USERNAME" >/dev/null 2>&1 || true
}

prompt_text() {
  local title="$1"
  local text="$2"
  local hidden="${3:-0}"

  if command -v zenity >/dev/null 2>&1; then
    if [[ "$hidden" == 1 ]]; then
      zenity --password --title="$title"
    else
      zenity --entry --title="$title" --text="$text"
    fi
  else
    printf '%s: ' "$text" >/dev/tty
    if [[ "$hidden" == 1 ]]; then
      read -r -s value </dev/tty
      printf '\n' >/dev/tty
      printf '%s\n' "$value"
    else
      read -r value </dev/tty
      printf '%s\n' "$value"
    fi
  fi
}

connect_vpn() {
  local supplied_otp="${1:-}"
  load_config
  [[ -n "$VPN_SERVER" && "$VPN_SERVER" != "vpn.example.com" ]] || die "Set VPN_SERVER in $CONFIG_FILE first."
  [[ -n "$VPN_USERNAME" && "$VPN_USERNAME" != "your.username" ]] || die "Set VPN_USERNAME in $CONFIG_FILE first."
  command -v openconnect >/dev/null 2>&1 || die "Install openconnect first: yay -S openconnect"
  if is_connected; then
    return 0
  fi

  local password otp
  password="$(read_secret)"
  if [[ -z "$password" ]]; then
    password="$(prompt_text "$VPN_NAME" "Password for $VPN_USERNAME" 1)"
    [[ -n "$password" ]] || die "Password prompt cancelled."
    store_secret "$password"
  fi

  otp="$supplied_otp"
  if [[ "${PROMPT_FOR_OTP:-1}" == 1 ]]; then
    [[ -n "$otp" ]] || otp="$(prompt_text "$VPN_NAME" "Two-factor code" 0)"
    [[ -n "$otp" ]] || die "Two-factor prompt cancelled."
  fi

  printf 'Connecting to %s as %s\n' "$VPN_SERVER" "$VPN_USERNAME"
  if [[ -n "${OPENCONNECT_AUTHGROUP:-}" ]]; then
    printf 'Auth group: %s\n' "$OPENCONNECT_AUTHGROUP"
  fi
  [[ -x "$PRIVILEGED_HELPER" ]] || die "Install the privileged helper described in the repository README first."

  if ! {
    printf '%s\n' "$password"
    [[ -n "$otp" ]] && printf '%s\n' "$otp"
  } | pkexec "$PRIVILEGED_HELPER" connect \
    "$OPENCONNECT_PROTOCOL" \
    "${OPENCONNECT_AUTHGROUP:-}" \
    "${OPENCONNECT_USER_AGENT:-}" \
    "$VPN_USERNAME" \
    "$VPN_SERVER"; then
    die "Connection failed."
  fi
}

disconnect_vpn() {
  load_config
  [[ -x "$PRIVILEGED_HELPER" ]] || die "Install the privileged helper described in the repository README first."
  sudo -n "$PRIVILEGED_HELPER" disconnect
}

edit_config() {
  ensure_config
  if command -v omarchy-launch-editor >/dev/null 2>&1; then
    exec omarchy-launch-editor "$CONFIG_FILE"
  fi

  "${EDITOR:-nvim}" "$CONFIG_FILE"
}

setup_config() {
  ensure_config
  load_config
  printf 'Config: %s\n' "$CONFIG_FILE"
  printf 'Password keyring label: %s password\n' "$VPN_NAME"
  printf '\nEdit the config, then run: omarchy-work-vpn connect\n'
}

usage() {
  cat <<'EOF'
Usage: omarchy-work-vpn <status|connect|disconnect|toggle|setup|edit>

Commands:
  status      Print machine-readable JSON status.
  connect     Connect with OpenConnect.
  disconnect  Stop the OpenConnect process.
  toggle      Connect or disconnect based on current state.
  setup       Create the local config template.
  edit        Open the local config.
EOF
}

main() {
  case "${1:-toggle}" in
    status) json_status ;;
    connect)
      if [[ "${2:-}" == --otp ]]; then
        connect_vpn "${3:-}"
      else
        connect_vpn
      fi
      ;;
    disconnect) disconnect_vpn ;;
    toggle)
      load_config
      if is_connected; then disconnect_vpn; else connect_vpn; fi
      ;;
    setup) setup_config ;;
    edit) edit_config ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
