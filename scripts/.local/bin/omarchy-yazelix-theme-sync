#!/usr/bin/env bash
set -euo pipefail

THEME_NAME="${1:-}"
OMARCHY_THEME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/current/theme"
YAZELIX_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/yazelix"
YAZELIX_STATE_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/yazelix"
HOST_GHOSTTY_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config"
MARKER_BEGIN="// >>> dotfiles-managed omarchy yazelix theme >>>"
MARKER_END="// <<< dotfiles-managed omarchy yazelix theme <<<"
SHELL_MARKER_BEGIN="# >>> dotfiles-managed omarchy yazelix theme >>>"
SHELL_MARKER_END="# <<< dotfiles-managed omarchy yazelix theme <<<"

profile_path() {
  export PATH="$HOME/.nix-profile/bin:/nix/var/nix/profiles/default/bin:$PATH"
}

remove_managed_block() {
  local file="$1"
  local begin="$2"
  local end="$3"

  [[ -f "$file" ]] || return 0
  python3 - "$file" "$begin" "$end" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
begin = sys.argv[2]
end = sys.argv[3]
lines = path.read_text().splitlines()
out = []
skipping = False

for line in lines:
    if line == begin:
        skipping = True
        continue
    if line == end:
        skipping = False
        continue
    if not skipping:
        out.append(line)

text = "\n".join(out).rstrip() + "\n"
path.write_text(text)
PY
}

append_managed_block() {
  local file="$1"
  local begin="$2"
  local end="$3"
  local content_file="$4"

  mkdir -p "$(dirname "$file")"
  touch "$file"
  remove_managed_block "$file" "$begin" "$end"
  {
    printf '\n%s\n' "$begin"
    cat "$content_file"
    printf '%s\n' "$end"
  } >>"$file"
}

sync_settings() {
  profile_path

  local mode="dark"
  [[ -f "$OMARCHY_THEME_DIR/light.mode" ]] && mode="light"

  if command -v yzx >/dev/null 2>&1; then
    yzx config set appearance.mode "\"$mode\""
    yzx config set zellij.theme '"omarchy"'
    yzx config set yazi.theme '"omarchy"'
    yzx config set zellij.custom_popups '[{"id":"zenith","command":["zenith"],"keybindings":["Alt Shift I"],"keep_alive":true}]'
    return 0
  fi

  printf 'yzx is not on PATH; skipping settings.jsonc update.\n' >&2
  return 0
}

sync_cursors() {
  profile_path

  if command -v yzx >/dev/null 2>&1; then
    yzx config set cursors.settings.trail '"none"'
    yzx config set cursors.settings.trail_effect '"none"'
    yzx config set cursors.settings.mode_effect '"none"'
    yzx config set cursors.settings.glow '"none"'
    yzx config set cursors.settings.kitty_enable_cursor 'false'
    return 0
  fi

  printf 'yzx is not on PATH; skipping cursor settings update.\n' >&2
  return 0
}

sync_ghostty() {
  local source="$OMARCHY_THEME_DIR/ghostty.conf"
  local target="$YAZELIX_CONFIG_DIR/terminal_ghostty.conf"
  local tmp

  [[ -f "$source" ]] || return 0
  tmp="$(mktemp)"
  {
    printf '# Generated from Omarchy theme: %s\n' "${THEME_NAME:-$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/current/theme.name" 2>/dev/null || true)}"
    cat "$source"
    if [[ -f "$HOST_GHOSTTY_CONFIG" ]]; then
      printf '\n# Native Ghostty geometry/font settings\n'
      grep -E '^(font-family|font-style|font-size|window-padding-x|window-padding-y|cursor-style|cursor-style-blink)[[:space:]]*=' "$HOST_GHOSTTY_CONFIG" || true
    fi
  } >"$tmp"
  append_managed_block "$target" "$SHELL_MARKER_BEGIN" "$SHELL_MARKER_END" "$tmp"
  rm -f "$tmp"
}

sync_helix() {
  local source="$OMARCHY_THEME_DIR/helix.toml"
  local theme_target="$YAZELIX_CONFIG_DIR/helix/themes/omarchy.toml"
  local config_target="$YAZELIX_CONFIG_DIR/helix/config.toml"
  local tmp

  [[ -f "$source" ]] || return 0
  mkdir -p "$(dirname "$theme_target")"
  cp "$source" "$theme_target"

  tmp="$(mktemp)"
  cat >"$tmp" <<'EOF'
theme = "omarchy"

[keys.normal.space.q]
q = ":sh zellij run -c -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-yazi-picker open >/dev/null"
v = ":sh zellij run -c -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-yazi-picker vsplit >/dev/null"
s = ":sh zellij run -c -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-yazi-picker hsplit >/dev/null"
r = ":sh zellij run -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-serpl >/dev/null"
EOF
  append_managed_block "$config_target" "$SHELL_MARKER_BEGIN" "$SHELL_MARKER_END" "$tmp"
  rm -f "$tmp"
}

cleanup_helix_steel_experiment() {
  local target="$YAZELIX_STATE_DIR/configs/helix/helix.scm"
  [[ -f "$target" ]] || return 0

  python3 - "$target" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text()

for command in ("yzx-yazi-open", "yzx-yazi-vsplit", "yzx-yazi-hsplit", "yzx-serpl-replace"):
    text = re.sub(rf"\n;; - {re.escape(command)} \[omarchy\]: [^\n]*", "", text)

text = re.sub(
    r"\(provide ([^)]*)\)",
    lambda m: "(provide " + " ".join(part for part in m.group(1).split() if part not in {
        "yzx-yazi-open",
        "yzx-yazi-vsplit",
        "yzx-yazi-hsplit",
        "yzx-serpl-replace",
    }) + ")",
    text,
    count=1,
)
text = re.sub(
    r"\n;; >>> dotfiles-managed omarchy yazelix helix commands >>>.*?;; <<< dotfiles-managed omarchy yazelix helix commands <<<\n",
    "\n",
    text,
    flags=re.S,
)

path.write_text(text.rstrip() + "\n")
PY
}

sync_zellij() {
  local source="$OMARCHY_THEME_DIR/colors.toml"
  local target="$YAZELIX_CONFIG_DIR/zellij.kdl"
  local tmp

  [[ -f "$source" ]] || return 0
  tmp="$(mktemp)"

  python3 - "$source" >"$tmp" <<'PY'
import pathlib
import sys
import tomllib

colors = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())

def rgb(key):
    value = colors[key].strip().lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))

mapping = {
    "fg": "foreground",
    "bg": "background",
    "black": "color0",
    "red": "color1",
    "green": "color2",
    "yellow": "color3",
    "blue": "color4",
    "magenta": "color5",
    "cyan": "color6",
    "white": "color7",
    "orange": "accent",
}

print("themes {")
print("    omarchy {")
for zellij_name, color_key in mapping.items():
    r, g, b = rgb(color_key)
    print(f"        {zellij_name} {r} {g} {b}")

def style(name, base_key, emphasis_keys):
    r, g, b = rgb(base_key)
    print(f"        {name} {{")
    print(f"            base {r} {g} {b}")
    print("            background 0")
    for index, key in enumerate(emphasis_keys):
        if key == "transparent":
            print(f"            emphasis_{index} 0")
        else:
            r, g, b = rgb(key)
            print(f"            emphasis_{index} {r} {g} {b}")
    print("        }")

style("frame_unselected", "color2", ["accent", "color6", "color5", "transparent"])
style("frame_selected", "foreground", ["accent", "color6", "color5", "transparent"])
style("frame_highlight", "accent", ["color5", "accent", "accent", "accent"])

print("    }")
print("}")
PY

  append_managed_block "$target" "$MARKER_BEGIN" "$MARKER_END" "$tmp"
  rm -f "$tmp"
}

sync_yazi() {
  local source="$OMARCHY_THEME_DIR/colors.toml"
  local target="$YAZELIX_CONFIG_DIR/yazi/flavors/omarchy.yazi/flavor.toml"

  [[ -f "$source" ]] || return 0
  mkdir -p "$(dirname "$target")"

  python3 - "$source" >"$target" <<'PY'
import pathlib
import sys
import tomllib

colors = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())

def c(key):
    return colors[key].strip()

bg = c("background")
fg = c("foreground")
muted = c("color5")
subtle = c("color0")
accent = c("accent")
red = c("color1")
green = c("color2")
yellow = c("color3")
blue = c("color4")
magenta = c("color5")
cyan = c("color6")
white = c("color7")

print(f'''# Generated from the active Omarchy theme.

[mgr]
cwd = {{ fg = "{fg}", bold = true }}
hovered = {{ fg = "{fg}", bg = "{subtle}" }}
preview_hovered = {{ underline = true }}
find_keyword = {{ fg = "{bg}", bg = "{accent}", bold = true }}
find_position = {{ fg = "{muted}", italic = true }}
marker_copied = {{ fg = "{green}", bg = "{green}" }}
marker_cut = {{ fg = "{red}", bg = "{red}" }}
marker_marked = {{ fg = "{cyan}", bg = "{cyan}" }}
marker_selected = {{ fg = "{accent}", bg = "{accent}" }}
count_copied = {{ fg = "{green}", bold = true }}
count_cut = {{ fg = "{red}", bold = true }}
count_selected = {{ fg = "{accent}", bold = true }}
border_symbol = "│"
border_style = {{ fg = "{subtle}" }}

[tabs]
active = {{ fg = "{fg}", bg = "{subtle}", bold = true }}
inactive = {{ fg = "{muted}", bg = "{bg}" }}
sep_inner = {{ open = "", close = "" }}
sep_outer = {{ open = "", close = "" }}

[mode]
normal_main = {{ fg = "{fg}", bg = "{subtle}", bold = true }}
normal_alt = {{ fg = "{muted}", bg = "{bg}" }}
select_main = {{ fg = "{bg}", bg = "{accent}", bold = true }}
select_alt = {{ fg = "{accent}", bg = "{subtle}" }}
unset_main = {{ fg = "{bg}", bg = "{accent}", bold = true }}
unset_alt = {{ fg = "{accent}", bg = "{subtle}" }}

[status]
overall = {{ fg = "{fg}", bg = "{bg}" }}
perm_type = {{ fg = "{blue}" }}
perm_read = {{ fg = "{yellow}" }}
perm_write = {{ fg = "{red}" }}
perm_exec = {{ fg = "{green}" }}
perm_sep = {{ fg = "{muted}" }}
progress_label = {{ fg = "{bg}" }}
progress_normal = {{ fg = "{accent}", bg = "{subtle}" }}
progress_error = {{ fg = "{bg}", bg = "{red}" }}

[which]
cols = 3
mask = {{ bg = "{bg}" }}
cand = {{ fg = "{accent}", bold = true }}
rest = {{ fg = "{accent}", italic = true }}
desc = {{ fg = "{muted}", italic = true }}
separator = " "
separator_style = {{ }}

[confirm]
border = {{ fg = "{subtle}" }}
title = {{ fg = "{muted}", bold = true }}
content = {{ fg = "{fg}", bold = true }}
list = {{ fg = "{fg}" }}
btn_yes = {{ fg = "{bg}", bg = "{accent}", bold = true }}
btn_no = {{ fg = "{muted}", bg = "{subtle}" }}

[spot]
border = {{ fg = "{subtle}" }}
title = {{ fg = "{muted}", bold = true }}
tbl_col = {{ fg = "{muted}" }}
tbl_cell = {{ bg = "{bg}" }}

[notify]
title_info = {{ fg = "{blue}" }}
title_warn = {{ fg = "{yellow}" }}
title_error = {{ fg = "{red}" }}

[pick]
border = {{ fg = "{subtle}", bold = true }}
active = {{ fg = "{fg}" }}
inactive = {{ fg = "{muted}" }}

[input]
border = {{ fg = "{subtle}" }}
title = {{ fg = "{muted}", bold = true }}
value = {{ fg = "{fg}" }}
selected = {{ bg = "{subtle}" }}

[cmp]
border = {{ fg = "{subtle}", bold = true }}
active = {{ fg = "{fg}", bg = "{subtle}" }}
inactive = {{ fg = "{muted}" }}

[tasks]
border = {{ fg = "{subtle}" }}
title = {{ fg = "{muted}", bold = true }}
hovered = {{ bg = "{subtle}" }}

[help]
on = {{ fg = "{accent}" }}
run = {{ fg = "{green}" }}
desc = {{ fg = "{muted}", italic = true }}
hovered = {{ bg = "{subtle}" }}
footer = {{ fg = "{fg}", bg = "{subtle}", bold = true }}

[filetype]
rules = [
  {{ mime = "image/*", fg = "{magenta}" }},
  {{ mime = "video/*", fg = "{yellow}" }},
  {{ mime = "audio/*", fg = "{yellow}" }},
  {{ url = "*", is = "orphan", fg = "{muted}", crossed = true }},
  {{ url = "*/", is = "orphan", fg = "{muted}", crossed = true }},
  {{ url = "*", is = "link", fg = "{cyan}" }},
  {{ url = "*/", is = "link", fg = "{cyan}" }},
  {{ url = "*", is = "exec", fg = "{green}" }},
  {{ mime = "inode/empty", fg = "{muted}" }},
  {{ url = "*", fg = "{white}" }},
  {{ url = "*/", fg = "{fg}" }},
]
''')
PY
}

patch_generated_zellij() {
  local colors_file="$OMARCHY_THEME_DIR/colors.toml"
  local layouts_dir="$YAZELIX_STATE_DIR/configs/zellij/layouts"
  local config_file="$YAZELIX_STATE_DIR/configs/zellij/config.kdl"
  local user_config="$YAZELIX_CONFIG_DIR/zellij.kdl"
  [[ -f "$colors_file" ]] || return 0

  python3 - "$colors_file" "$layouts_dir" "$config_file" "$user_config" <<'PY'
import pathlib
import re
import sys
import tomllib

colors = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())
layouts = pathlib.Path(sys.argv[2])
config = pathlib.Path(sys.argv[3])
user_config = pathlib.Path(sys.argv[4])

bg = colors["background"].strip()
fg = colors["foreground"].strip()
subtle = colors["color0"].strip()
muted = colors["color5"].strip()
accent = colors["accent"].strip()
warn = colors["color3"].strip()
alert = colors["color1"].strip()

replacements = {
    "#00ff88": accent,
    "#ff6600": warn,
    "#ff0088": alert,
    "#00ccff": muted,
    "#bb88ff": muted,
    "#ffff00": muted,
    "#000000": bg,
    "#ffffff": fg,
}

if layouts.is_dir():
    for path in layouts.glob("*.kdl"):
        text = path.read_text()
        for old, new in replacements.items():
            text = text.replace(old, new)
        text = text.replace("mode_normal  \"#[bg=" + accent + ",fg=" + bg + ",bold] NORMAL \"",
                            "mode_normal  \"#[fg=" + fg + ",bg=" + subtle + "] normal \"")
        text = text.replace("tab_active   \"#[bg=" + warn + ",fg=" + bg + ",bold]",
                            "tab_active   \"#[bg=" + subtle + ",fg=" + fg + ",bold]")
        text = text.replace("tab_active_fullscreen \"#[bg=" + warn + ",fg=" + bg + ",bold]",
                            "tab_active_fullscreen \"#[bg=" + subtle + ",fg=" + fg + ",bold]")
        text = text.replace("tab_active_sync       \"#[bg=" + warn + ",fg=" + bg + ",bold]",
                            "tab_active_sync       \"#[bg=" + subtle + ",fg=" + fg + ",bold]")
        path.write_text(text)

if config.is_file():
    text = config.read_text()
    if user_config.is_file():
        user_text = user_config.read_text()
        marker_re = re.compile(
            r"// >>> dotfiles-managed omarchy yazelix theme >>>.*?// <<< dotfiles-managed omarchy yazelix theme <<<",
            re.S,
        )
        user_block = marker_re.search(user_text)
        generated_block = marker_re.search(text)
        if user_block and generated_block:
            text = text[:generated_block.start()] + user_block.group(0) + text[generated_block.end():]
    text = re.sub(
        r'''\n        bind "Alt Shift S" \{\n            (?:Run "omarchy-yazelix-serpl" \{\n                floating true\n                width "90%"\n                height "90%"\n                name "serpl"\n                close_on_exit true\n            \}\n            SwitchToMode "Normal"|MessagePlugin "yzpp" \{\n                name "toggle"\n                payload "serpl"\n            \})\n        \}''',
        "",
        text,
    )
    text = re.sub(
        r'''\n            serpl \{\n                command "[^"]+"\n                arg_1 "popup_run"\n                arg_2 "omarchy-yazelix-serpl"\n                command_marker "yzx_serpl"\n                pane_title "yzx_serpl"\n                width_percent "90"\n                height_percent "90"\n            \}''',
        "",
        text,
    )
    config.write_text(text)
PY
}

patch_generated_helix() {
  local config="$YAZELIX_STATE_DIR/configs/helix/config.toml"
  [[ -f "$config" ]] || return 0

  python3 - "$config" <<'PY'
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
lines = path.read_text().splitlines()
out = []
skip = False
skip_serpl_backspace = False
skip_old_serpl_alt = False
skip_orphan_serpl_alt = False
skip_space_q = False
section = ""
space_q_block = [
    "[keys.normal.space.q]",
    'q = ":sh zellij run -c -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-yazi-picker open >/dev/null"',
    'v = ":sh zellij run -c -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-yazi-picker vsplit >/dev/null"',
    's = ":sh zellij run -c -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-yazi-picker hsplit >/dev/null"',
    'r = ":sh zellij run -f -x 10%% -y 10%% --width 80%% --height 80%% -- omarchy-yazelix-serpl >/dev/null"',
]

for line in lines:
    if line.startswith("[") and line.endswith("]"):
        section = line
        if skip_space_q:
            skip_space_q = False
    if line in {"[editor.statusline]", "[editor.cursor-shape]"}:
        skip = True
        continue
    if line == "[keys.normal.space.q]":
        skip_space_q = True
        continue
    if skip_space_q:
        continue
    if skip and line.startswith("[") and line.endswith("]"):
        skip = False
    if line == 's = [' and section == "[keys.normal.backspace]":
        skip_serpl_backspace = True
        continue
    if skip_serpl_backspace:
        if line == "]":
            skip_serpl_backspace = False
        continue
    if section == "[keys.normal]" and line.startswith("A-S = ["):
        skip_old_serpl_alt = True
        continue
    if skip_old_serpl_alt:
        if line == "]":
            skip_old_serpl_alt = False
        continue
    if section == "[keys.normal]" and line.strip() == '":write-all",':
        skip_orphan_serpl_alt = True
        continue
    if skip_orphan_serpl_alt:
        if line == "]":
            skip_orphan_serpl_alt = False
        continue
    if section == "[keys.normal]" and line.startswith("A-S ="):
        continue
    if not skip:
        out.append(line)

insert_at = len(out)
for index, line in enumerate(out):
    if line.startswith("[keys.normal.") and line != "[keys.normal]":
        insert_at = index
        break
out[insert_at:insert_at] = ["", *space_q_block]

path.write_text("\n".join(out).rstrip() + "\n")
PY
}

main() {
  [[ -d "$OMARCHY_THEME_DIR" ]] || {
    printf 'Missing Omarchy current theme directory: %s\n' "$OMARCHY_THEME_DIR" >&2
    exit 1
  }

  mkdir -p "$YAZELIX_CONFIG_DIR"
  sync_ghostty
  sync_helix
  cleanup_helix_steel_experiment
  sync_zellij
  sync_yazi
  sync_settings
  sync_cursors
  patch_generated_zellij
  patch_generated_helix
}

main "$@"
