#!/usr/bin/env bash
# hide-scratch — open the persistent scratch shell inside a popup. A dedicated tmux session
# ('scratch') on the hide socket, so its shell state survives closing and reopening the popup.
# Named WITHOUT the 'hide-' prefix so it never appears in the project tabs strip or switcher,
# and status is off so the popup is a clean bare shell.
#
# Toggle is handled in tmux.conf: Ctrl+Alt+T opens this popup from a project, and the same key
# inside the popup (session = scratch) detaches, closing it. Detach keeps the session alive.
set -uo pipefail
sock="${HIDE_SOCKET:-hide}"

if ! command tmux -L "$sock" has-session -t '=scratch' 2>/dev/null; then
    command tmux -L "$sock" new-session -d -s scratch -c "$HOME"
    command tmux -L "$sock" set-option -t scratch status off
fi

# Unset TMUX so attaching inside the popup doesn't trip tmux's nested-session guard.
unset TMUX TMUX_PANE
exec command tmux -L "$sock" attach -t '=scratch'
