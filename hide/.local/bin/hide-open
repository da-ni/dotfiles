#!/usr/bin/env bash
# hide-open — yazi file picker (a transient tmux window, chooser mode). The picked file opens
# in the Helix editor pane via hide-bridge, in the mode given by HIDE_OPEN_MODE:
#   open   (default) -> current view      [Ctrl+Alt+O]
#   vsplit           -> vertical split    [Ctrl+Alt+V]
# The mode is chosen at launch, NOT by an in-picker key: yazi's `shell` action does not fire in
# this build (every documented form is a no-op), so the chooser-file is the only thing that
# reliably reports the selection. Navigate as usual; Enter picks the file.
set -uo pipefail
mode="${HIDE_OPEN_MODE:-open}"
sock="${HIDE_SOCKET:-hide}"
tmux() { command tmux -L "$sock" "$@"; }
S="${HIDE_SESSION:-$(tmux display-message -p '#{session_name}' 2>/dev/null)}"

root="$(tmux show-options -t "$S" -v @hide_root 2>/dev/null)"
[ -n "${root:-}" ] && cd "$root" 2>/dev/null

export YAZI_CONFIG_HOME="${HIDE_CONFIG_DIR:-$HOME/.config/hide}/yazi"
export HIDE_SESSION="$S" HIDE_SOCKET="$sock"

chooser="$(mktemp)"; trap 'rm -f "$chooser"' EXIT
yazi --chooser-file="$chooser" . 2>/dev/null
sel="$(head -n1 "$chooser" 2>/dev/null)"
[ -z "${sel:-}" ] && exit 0
# yazi returns picks from its search view as 'search://<args>//<abs-path>'. Extract the real path.
case "$sel" in search://*) sel="$(printf '%s' "$sel" | sed -E 's#^search://[^/]*/##')";; esac

hide-bridge "$mode" "$sel"
