#!/usr/bin/env bash
# hide-switch — in-session project switcher (Ctrl+Alt+W). Gets a choice from the shared picker
# (hide-pick), then acts: switch to an open project, or launch a frecent dir and switch to it.
set -uo pipefail
sock="${HIDE_SOCKET:-hide}"
tmux() { command tmux -L "$sock" "$@"; }
S="${HIDE_SESSION:-$(tmux display-message -p '#{session_name}' 2>/dev/null)}"

out="$(HIDE_SOCKET="$sock" HIDE_SESSION="$S" hide-pick)" || exit 0
action="${out%%	*}"; value="${out#*	}"
case "$action" in
    switch) tmux switch-client -t "=$value" ;;
    open)
        # Build at the current client's width so switch-client needs no width rescale (which would
        # race hide-init). Then normalize explicitly — the build leaves the terminal visible.
        cols="$(tmux display -p -t "$S" '#{window_width}' 2>/dev/null)"
        s="$(HIDE_NO_ATTACH=1 HIDE_BUILD_COLS="$cols" hide "$value")"
        [ -n "${s:-}" ] || exit 0
        tmux switch-client -t "=$s"
        HIDE_SESSION="$s" HIDE_SOCKET="$sock" hide-init
        ;;
esac
