#!/usr/bin/env bash
# hide-switch — in-session project switcher (Ctrl+Alt+W). Gets a choice from the shared picker
# (hide-pick), then acts: switch to an open project, or launch a frecent dir and switch to it.
set -uo pipefail
sock="${HIDE_SOCKET:-hide}"
tmux() { command tmux -L "$sock" "$@"; }
S="${HIDE_SESSION:-$(tmux display-message -p '#{session_name}' 2>/dev/null)}"

out="$(HIDE_SOCKET="$sock" HIDE_SESSION="$S" hide-pick)" || exit 0
action="${out%%	*}"; value="${out#*	}"
case "$action" in
    switch) tmux switch-client -t "=$value" ;;
    open)   s="$(HIDE_NO_ATTACH=1 hide "$value")"; [ -n "${s:-}" ] && tmux switch-client -t "=$s" ;;
esac
