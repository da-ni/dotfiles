#!/usr/bin/env bash
# hide-keys — print the hide keybind cheatsheet, shown in a popup (Ctrl+Alt+K). Any key closes it.
# Kept in sync by hand with tmux.conf; grouped the way you actually reach for them.
set -uo pipefail
row() { printf '    %-13s%s\n' "$1" "$2"; }

printf '\n  hide keybinds\n\n'

echo "  Panes"
row "Ctrl+Space"  "toggle agent pane"
row "Alt+Space"   "toggle terminal pane"
row "Ctrl+Y"      "focus agent"
row "Alt+Y"       "focus terminal"
row "Alt+H/J/K/L" "move between panes"
echo

echo "  Tools"
row "Ctrl+Alt+G"  "lazygit"
row "Ctrl+Alt+O"  "open file (picker)"
row "Ctrl+Alt+V"  "open file in vertical split"
row "Ctrl+Alt+F"  "project search"
row "Ctrl+Alt+R"  "project search & replace"
row "Ctrl+Alt+T"  "scratch shell (toggle)"
row "Ctrl+Alt+E"  "re-run last terminal command"
echo

echo "  Projects"
row "Ctrl+Alt+W"  "switch / open project"
row "Ctrl+Alt+A"  "switch agent (Codex / Claude / opencode)"
row "Ctrl+Alt+Q"  "close hide session"
echo

echo "  Help"
row "Ctrl+Alt+K"  "this overview"
echo
printf '  (Helix splits: Ctrl+W then H/J/K/L)\n\n'
printf '  press any key to close\n'

# Wait for a single keypress, then exit — that closes the popup.
read -rsn1 _ 2>/dev/null || true
