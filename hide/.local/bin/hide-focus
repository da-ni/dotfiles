#!/usr/bin/env bash
# hide-focus <role> — toggle focus between the editor and <role>.
#   In the editor -> focus <role> (revealing it if hidden).
#   In <role>     -> focus the editor.
# HIDE_ACTIVE = @role of the pane focused when invoked (passed by the keybind).
set -uo pipefail
role="${1:?usage: hide-focus <role>}"
sock="${HIDE_SOCKET:-hide}"; S="${HIDE_SESSION:-}"
tmux() { command tmux -L "$sock" "$@"; }
st=(); [ -n "$S" ] && st=(-t "$S")

target="$role"
[ "${HIDE_ACTIVE:-}" = "$role" ] && target=editor

ed=$(tmux list-panes -s "${st[@]}" -F '#{pane_id}	#{@role}' | awk -F'\t' '$2=="editor"{print $1; exit}')
[ -z "${ed:-}" ] && exit 0
edwin=$(tmux display -p -t "$ed" '#{window_id}')

line=$(tmux list-panes -s "${st[@]}" -F '#{pane_id}	#{@role}	#{window_id}' | awk -F'\t' -v r="$target" '$2==r{print; exit}')
[ -z "${line:-}" ] && exit 0
pid=$(printf '%s' "$line" | cut -f1); pwin=$(printf '%s' "$line" | cut -f3)

# Reveal the target if it's hidden (only non-editor roles can be off-screen).
[ "$pwin" != "$edwin" ] && HIDE_SESSION="$S" HIDE_SOCKET="$sock" hide-toggle "$target"
tmux select-pane -t "$pid"
