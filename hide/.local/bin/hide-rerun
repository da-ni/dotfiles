#!/usr/bin/env bash
# hide-rerun — re-run the last command in the bottom terminal without leaving the editor.
# Reveals the terminal if it's hidden, sends bash history-expansion '!!' to re-run the last
# command, then restores focus to whatever pane you triggered it from (non-disruptive: run it
# from the editor and output appears in the now-visible terminal while focus stays on your code).
# Scope is deliberately "re-run last" — no per-project task config (that's scope creep).
set -uo pipefail
sock="${HIDE_SOCKET:-hide}"; S="${HIDE_SESSION:-$(command tmux -L "$sock" display-message -p '#{session_name}' 2>/dev/null)}"
tmux() { command tmux -L "$sock" "$@"; }
st=(); [ -n "$S" ] && st=(-t "$S")

focused="$(tmux display -p "${st[@]}" '#{pane_id}')"   # restore here afterwards

ed=$(tmux list-panes -s "${st[@]}" -F '#{pane_id}	#{@role}' | awk -F'\t' '$2=="editor"{print $1; exit}')
edwin=$(tmux display -p -t "$ed" '#{window_id}' 2>/dev/null)

line=$(tmux list-panes -s "${st[@]}" -F '#{pane_id}	#{@role}	#{window_id}' | awk -F'\t' '$2=="terminal"{print; exit}')
[ -z "${line:-}" ] && { echo "hide-rerun: no terminal pane" >&2; exit 1; }
tid=$(printf '%s' "$line" | cut -f1); twin=$(printf '%s' "$line" | cut -f3)

# Reveal the terminal if it's hidden in a holding window.
[ "$twin" != "$edwin" ] && HIDE_SESSION="$S" HIDE_SOCKET="$sock" hide-toggle terminal

# '!!' is the shell's last-command recall — assumes bash/zsh with interactive history expansion.
tmux send-keys -t "$tid" -l '!!'    # literal, so tmux doesn't treat it as a key name
tmux send-keys -t "$tid" Enter

[ -n "${focused:-}" ] && tmux select-pane -t "$focused"   # leave focus where it started
