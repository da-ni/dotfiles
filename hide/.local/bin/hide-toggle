#!/usr/bin/env bash
# hide-toggle — fully show/hide a role's pane with ZERO footprint, keep-alive.
# Hiding = break-pane to an off-screen holding window (process keeps running).
# Showing = join-pane back into position at its target size.
# usage: hide-toggle <terminal|agent>
set -uo pipefail
role="${1:?usage: hide-toggle <terminal|agent>}"
sock="${HIDE_SOCKET:-hide}"; S="${HIDE_SESSION:-}"
tmux() { command tmux -L "$sock" "$@"; }
st=(); [ -n "$S" ] && st=(-t "$S")

# The editor pane defines the "shown" window.
ed=$(tmux list-panes -s "${st[@]}" -F '#{pane_id}	#{@role}' | awk -F'\t' '$2=="editor"{print $1; exit}')
[ -z "${ed:-}" ] && { echo "hide-toggle: no editor pane" >&2; exit 1; }
edwin=$(tmux display -p -t "$ed" '#{window_id}')

# Locate the target role pane anywhere in the session, with its window.
line=$(tmux list-panes -s "${st[@]}" -F '#{pane_id}	#{@role}	#{window_id}' | awk -F'\t' -v r="$role" '$2==r{print; exit}')
[ -z "${line:-}" ] && { echo "hide-toggle: no $role pane" >&2; exit 1; }
pid=$(printf '%s' "$line" | cut -f1)
pwin=$(printf '%s' "$line" | cut -f3)

if [ "$pwin" = "$edwin" ]; then
    # currently shown -> hide it (break to an off-screen window, keep it running)
    tmux break-pane -d -n "_h_${role}" -s "$pid"
else
    # currently hidden -> show it back in position at its target size
    case "$role" in
        terminal) tmux join-pane -v -f -l 22% -s "$pid" -t "$ed" ;;  # full-width bottom
        agent)    tmux join-pane -h -l "${HIDE_AGENT_PCT:-22}%" -s "$pid" -t "$ed" ;;  # right of the editor
        *)        tmux join-pane -h -l "${HIDE_AGENT_PCT:-22}%" -s "$pid" -t "$ed" ;;
    esac
    tmux select-pane -t "$pid"
fi
