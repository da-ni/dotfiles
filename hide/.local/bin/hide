#!/usr/bin/env bash
# hide — Helix IDE on tmux. Fixed 3-pane layout, toggleable panes, owned & minimal.
#   [ editor (Helix) | agent (Codex) ]
#   [ terminal (toggles open/closed)  ]
# Usage: hide [dir]
#   hide <dir>      open that dir (resolved to its git root if inside a repo)
#   hide  (in repo) open the current repo
#   hide  (bare)    open the project picker: attach an open project, or open a frecent (zoxide) dir
# Runs on a dedicated tmux socket ("hide") so it never collides with other tmux.
set -uo pipefail

cfg="${HIDE_CONFIG_DIR:-$HOME/.config/hide}"
conf="$cfg/tmux.conf"
sock=hide

# Brief launch splash: cloud-face logo + 'h i d e' wordmark, centred, ~1s before the IDE takes
# over. Tunable via HIDE_SPLASH_SECS (0 disables). Shown only on real attaches, never on the
# HIDE_NO_ATTACH programmatic build path.
splash() {
    local secs="${HIDE_SPLASH_SECS:-1.618}"   # golden ratio φ
    [ "$secs" = 0 ] && return 0
    local cols lines i icon="${HIDE_ICON:-$HOME/.local/share/icons/hicolor/128x128/apps/hide.png}"
    cols=$(tput cols 2>/dev/null || echo 80); lines=$(tput lines 2>/dev/null || echo 24)
    printf '\033[?25l\033[2J\033[H'                            # hide cursor, clear, home

    if command -v chafa >/dev/null 2>&1 && command -v figlet >/dev/null 2>&1 && [ -f "$icon" ]; then
        # Big render: the cloud-face PNG as block-art (chafa) above a big 'hide' wordmark (figlet).
        local imgw=28 img txt total pad lpad
        img="$(chafa -s "${imgw}x14" -f symbols "$icon" 2>/dev/null)"
        txt="$(figlet -c -w "$cols" hide 2>/dev/null)"
        total=$(( $(printf '%s\n' "$img" | wc -l) + 1 + $(printf '%s\n' "$txt" | wc -l) ))
        pad=$(( (lines - total) / 2 )); [ "$pad" -lt 0 ] && pad=0
        lpad=$(( (cols - imgw) / 2 )); [ "$lpad" -lt 0 ] && lpad=0
        for ((i = 0; i < pad; i++)); do printf '\n'; done
        printf '%s\n' "$img" | while IFS= read -r l; do printf '%*s%s\n' "$lpad" '' "$l"; done
        printf '\n%s\n' "$txt"                                 # figlet -c is already centred
    else
        # Fallback (chafa/figlet absent): the simple one-line centred logo.
        local pad lpad logo="😶‍🌫️  h i d e"
        pad=$(( lines / 2 - 1 )); [ "$pad" -lt 0 ] && pad=0
        lpad=$(( (cols - 13) / 2 )); [ "$lpad" -lt 0 ] && lpad=0
        for ((i = 0; i < pad; i++)); do printf '\n'; done
        printf '%*s\033[1m%s\033[0m' "$lpad" '' "$logo"
    fi

    sleep "$secs"
    printf '\033[2J\033[H\033[?25h'                            # clear, restore cursor, before the picker/IDE
}

# Splash FIRST, so the launch sequence is: logo -> picker -> IDE. Skip on the HIDE_NO_ATTACH
# programmatic path (in-session project switches must stay instant).
[ -z "${HIDE_NO_ATTACH:-}" ] && splash

# Resolve the target. Bare launch outside a repo opens the shared project picker (hide-pick) in
# the raw terminal: pick an open project to attach, or a frecent zoxide dir to open. For a dir
# zoxide doesn't know, pass it explicitly: `hide <path>`.
if [ -n "${1:-}" ]; then
    target="$1"
elif git rev-parse --show-toplevel >/dev/null 2>&1; then
    target="$PWD"
else
    out="$(HIDE_SOCKET="$sock" hide-pick)" || { printf 'hide: no project selected\n' >&2; exit 0; }
    if [ "${out%%	*}" = switch ]; then           # an already-open project -> attach it
        sess="${out#*	}"
        tmux -L "$sock" source-file "$conf"
        exec tmux -L "$sock" attach -t "=$sess"
    fi
    target="${out#*	}"                            # a frecent dir -> fall through to resolve + build
fi
cd "$target" 2>/dev/null || { printf 'hide: no such dir: %s\n' "$target" >&2; exit 1; }
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$root" || exit 1
name="$(basename "$root")"
session="hide-${name//[^A-Za-z0-9_-]/_}"
# Basename-collision guard: if a session with this name already exists for a DIFFERENT root,
# suffix a short hash of the root so two same-named projects (e.g. ~/work/api and ~/play/api)
# get distinct sessions instead of one silently attaching the other.
if tmux -L "$sock" has-session -t "=$session" 2>/dev/null; then
    existing_root="$(tmux -L "$sock" show-options -t "$session" -v @hide_root 2>/dev/null || true)"
    [ -n "$existing_root" ] && [ "$existing_root" != "$root" ] && \
        session="${session}-$(printf '%s' "$root" | cksum | cut -d' ' -f1 | cut -c1-4)"
fi

# HIDE_NO_ATTACH=1 → build/ensure the session, print its name, and DON'T attach. Used by the
# unified switcher (hide-switch) to open a closed project from inside a running hide session,
# then switch-client to it. Keeps all session-building logic here (one source of truth).
noattach="${HIDE_NO_ATTACH:-}"

# Already running for this project? Attach (or just report it).
if tmux -L "$sock" has-session -t "=$session" 2>/dev/null; then
    tmux -L "$sock" source-file "$conf"   # refresh binds/options even on an already-running server
    [ -n "$noattach" ] && { printf '%s\n' "$session"; exit 0; }
    exec tmux -L "$sock" attach -t "$session"
fi

# Build the fixed layout, detached, then attach.
tmux -L "$sock" -f "$conf" new-session -d -s "$session" -n main -c "$root" "helix ."
ed=$(tmux -L "$sock" list-panes -t "$session" -F '#{pane_id}' | head -1)
term=$(tmux -L "$sock" split-window -v -l 1   -t "$ed" -c "$root" -P -F '#{pane_id}')
agent=$(tmux -L "$sock" split-window -h -l 30% -t "$ed" -c "$root" -P -F '#{pane_id}' "codex")

# Tag panes with a stable role (a pane user-option programs can't clobber, unlike titles).
tmux -L "$sock" set-option -p -t "$ed"    @role editor
tmux -L "$sock" set-option -p -t "$ed"    remain-on-exit on   # if Helix exits, KEEP the pane (dead, visible) instead of silently breaking the layout
tmux -L "$sock" set-option -p -t "$term"  @role terminal
tmux -L "$sock" set-option -p -t "$agent" @role agent
tmux -L "$sock" set-option    -t "$session" @hide_root "$root"   # project root for popups
tmux -L "$sock" select-pane -t "$ed"    # land focus in the editor (the picker)

tmux -L "$sock" source-file "$conf"   # ensure latest config even if the server was already up
[ -n "$noattach" ] && { printf '%s\n' "$session"; exit 0; }
exec tmux -L "$sock" attach -t "$session"
