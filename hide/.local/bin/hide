#!/usr/bin/env bash
# hide — Helix IDE on tmux. Fixed 3-pane layout, toggleable panes, owned & minimal.
#   [ editor (Helix) | agent (Codex) ]
#   [ terminal (toggles open/closed)  ]
# Usage: hide [dir]
#   hide <dir>      open that dir (resolved to its git root if inside a repo)
#   hide  (in repo) open the current repo
#   hide  (bare)    open a yazi workspace picker: navigate to a project, quit, it opens there
# Runs on a dedicated tmux socket ("hide") so it never collides with other tmux.
set -uo pipefail

cfg="${HIDE_CONFIG_DIR:-$HOME/.config/hide}"
conf="$cfg/tmux.conf"
sock=hide

# Resolve the target dir. Bare launch outside a repo opens the yazi workspace picker — and
# since there's no tmux yet, yazi runs in the raw terminal (no popup, no terminal-probe TRT).
if [ -n "${1:-}" ]; then
    target="$1"
elif git rev-parse --show-toplevel >/dev/null 2>&1; then
    target="$PWD"
else
    # Pick a workspace with yazi: navigate INTO a project, press q. yazi --cwd-file is a full
    # file manager, so EDITOR/VISUAL are neutered here — hitting Enter on a file must NOT spawn
    # a bare Helix outside hide (that was the "yazi opens Helix, no tmux" bug). q captures the dir.
    cwdf="$(mktemp)"
    EDITOR=true VISUAL=true YAZI_CONFIG_HOME="$cfg/yazi-workspace" yazi --cwd-file="$cwdf" "${HIDE_WORKSPACE_ROOT:-$HOME}"
    target="$(cat "$cwdf" 2>/dev/null)"; rm -f "$cwdf"
    [ -n "$target" ] && [ -d "$target" ] || { printf 'hide: no workspace selected\n' >&2; exit 0; }
fi
cd "$target" 2>/dev/null || { printf 'hide: no such dir: %s\n' "$target" >&2; exit 1; }
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$root" || exit 1
name="$(basename "$root")"
session="hide-${name//[^A-Za-z0-9_-]/_}"

# Already running for this project? Attach.
if tmux -L "$sock" has-session -t "=$session" 2>/dev/null; then
    tmux -L "$sock" source-file "$conf"   # refresh binds/options even on an already-running server
    exec tmux -L "$sock" attach -t "$session"
fi

# Build the fixed layout, detached, then attach.
tmux -L "$sock" -f "$conf" new-session -d -s "$session" -n main -c "$root" "helix ."
ed=$(tmux -L "$sock" list-panes -t "$session" -F '#{pane_id}' | head -1)
term=$(tmux -L "$sock" split-window -v -l 1   -t "$ed" -c "$root" -P -F '#{pane_id}')
agent=$(tmux -L "$sock" split-window -h -l 30% -t "$ed" -c "$root" -P -F '#{pane_id}' "codex")

# Tag panes with a stable role (a pane user-option programs can't clobber, unlike titles).
tmux -L "$sock" set-option -p -t "$ed"    @role editor
tmux -L "$sock" set-option -p -t "$ed"    remain-on-exit on   # if Helix exits, KEEP the pane (dead, visible) instead of silently breaking the layout
tmux -L "$sock" set-option -p -t "$term"  @role terminal
tmux -L "$sock" set-option -p -t "$agent" @role agent
tmux -L "$sock" set-option    -t "$session" @hide_root "$root"   # project root for popups
tmux -L "$sock" select-pane -t "$ed"    # land focus in the editor (the picker)

tmux -L "$sock" source-file "$conf"   # ensure latest config even if the server was already up
exec tmux -L "$sock" attach -t "$session"
