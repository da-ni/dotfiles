#!/usr/bin/env bash
# hide-pick — shared project picker. Lists open hide projects (● switch) and frecent zoxide dirs
# (+ open), deduped by @hide_root. Enter selects; Ctrl-X closes (kills) the selected open project
# and refreshes the list in place. Prints the chosen line as '<action>\t<value>':
#   action=switch value=<session>   |   action=open value=<dir>
# Exit 1 (no output) if cancelled. Used by the bare-launch picker (raw terminal) and the in-session
# switcher (Ctrl+Alt+W popup); fzf draws on /dev/tty either way.
#
# Subcommands (invoked by the fzf binds, found on PATH):
#   hide-pick --menu          emit the picker rows
#   hide-pick --close A V      kill an open project (only when action=switch, never the current one)
set -uo pipefail
sock="${HIDE_SOCKET:-hide}"
cur="${HIDE_SESSION:-}"
tmux() { command tmux -L "$sock" "$@"; }

emit_menu() {
    local opensess s r disp d
    opensess="$(tmux list-sessions -F '#{session_name}	#{@hide_root}' 2>/dev/null | grep '^hide-' || true)"
    declare -A openroot
    while IFS=$'\t' read -r s r; do [ -n "${r:-}" ] && openroot["$r"]=1; done <<<"$opensess"
    while IFS=$'\t' read -r s r; do
        [ -n "${s:-}" ] || continue
        disp="${s#hide-}"; [ "$s" = "$cur" ] && disp="$disp ·current"
        printf '● %s\tswitch\t%s\n' "$disp" "$s"
    done <<<"$opensess"
    command -v zoxide >/dev/null 2>&1 && zoxide query -l 2>/dev/null | while IFS= read -r d; do
        [ -d "$d" ] || continue
        [ -n "${openroot[$d]:-}" ] && continue
        case "$d" in "$HOME"/*) disp="~${d#"$HOME"}" ;; *) disp="$d" ;; esac
        printf '+ %s\topen\t%s\n' "$disp" "$d"
    done
}

case "${1:-}" in
    --menu) emit_menu; exit 0 ;;
    --close)
        [ "${2:-}" = switch ] || exit 0          # only open projects are closable
        [ "${3:-}" = "$cur" ] && exit 0          # never close the session hosting the picker
        tmux kill-session -t "=${3:-}" 2>/dev/null || true
        exit 0 ;;
esac

export HIDE_SOCKET="$sock" HIDE_SESSION="$cur"   # so the reload/close subcommands inherit context
# {2}/{3} are the action/value fields of the selected line (fzf quotes them); --with-nth=1 shows
# only the display column. start:reload populates the list (no stdin); ctrl-x closes + refreshes.
opts=(--with-nth=1 --delimiter='\t' --prompt 'project> '
      --header 'Enter: switch / open   Ctrl-X: close   Esc: cancel'
      --bind 'start:reload(hide-pick --menu)'
      --bind 'ctrl-x:execute-silent(hide-pick --close {2} {3})+reload(hide-pick --menu)')
[ -z "${TMUX:-}" ] && opts+=(--layout=reverse --border=rounded --margin=12%,25% --info=inline)
sel="$(fzf "${opts[@]}" </dev/null)" || exit 1
[ -n "${sel:-}" ] || exit 1
printf '%s\t%s\n' "$(printf '%s' "$sel" | cut -f2)" "$(printf '%s' "$sel" | cut -f3)"
